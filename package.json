{
  "name": "personal-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "preview:cf": "wrangler pages dev .svelte-kit/cloudflare",
    "db:migrate:local": "wrangler d1 migrations apply personal-blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-blog-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
